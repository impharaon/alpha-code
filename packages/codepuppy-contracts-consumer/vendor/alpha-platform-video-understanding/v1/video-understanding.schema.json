{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-understanding.schema.json",
  "title": "VideoUnderstandingV1",
  "oneOf": [
    {
      "$ref": "#/$defs/VideoUnderstandingInputV1"
    },
    {
      "$ref": "#/$defs/VideoModelsV1"
    },
    {
      "$ref": "#/$defs/VideoUnderstandingResultV1"
    },
    {
      "$ref": "#/$defs/VideoJobResultV1"
    }
  ],
  "$defs": {
    "VideoUnderstandingInputV1": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "enum": [
            "gemini"
          ]
        },
        "source_range": {
          "type": "object",
          "properties": {
            "start_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "start_ms",
            "end_ms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "question",
        "source_range"
      ],
      "additionalProperties": false
    },
    "VideoModelsV1": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "default_model": {
          "type": "string",
          "enum": [
            "gemini"
          ]
        },
        "models": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "enum": [
                  "gemini"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "mimes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "video/mp4",
                    "video/mpeg",
                    "video/mov",
                    "video/avi",
                    "video/x-flv",
                    "video/mpg",
                    "video/webm",
                    "video/wmv",
                    "video/3gpp"
                  ]
                }
              },
              "inline_media_bytes_exclusive": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "upload_request_bytes_limit": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "upload_media_bytes_exclusive": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "upstream_request_bytes_limit": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "context_tokens": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "output_tokens": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "price": {
                "type": "object",
                "properties": {
                  "input_fen_per_million": {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
                  },
                  "output_fen_per_million": {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?![\\s\\S])"
                  }
                },
                "required": [
                  "input_fen_per_million",
                  "output_fen_per_million"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "label",
              "revision",
              "mimes",
              "inline_media_bytes_exclusive",
              "upload_request_bytes_limit",
              "upload_media_bytes_exclusive",
              "upstream_request_bytes_limit",
              "context_tokens",
              "output_tokens",
              "price"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "default_model",
        "models"
      ],
      "additionalProperties": false
    },
    "VideoUnderstandingResultV1": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "model": {
          "type": "string",
          "enum": [
            "gemini"
          ]
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "source_range": {
          "type": "object",
          "properties": {
            "start_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "start_ms",
            "end_ms"
          ],
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "model",
        "model_revision",
        "source_range",
        "usage",
        "text"
      ],
      "additionalProperties": false
    },
    "VideoJobResultV1": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "model": {
          "type": "string",
          "enum": [
            "gemini"
          ]
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "source_range": {
          "type": "object",
          "properties": {
            "start_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "start_ms",
            "end_ms"
          ],
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false
        },
        "response": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "inline"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "artifact"
                },
                "artifact_id": {
                  "type": "string",
                  "pattern": "^art_(job_[a-z0-9_]+)_(\\d+)_([0-9a-f]{8})$"
                }
              },
              "required": [
                "kind",
                "artifact_id"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "model",
        "model_revision",
        "source_range",
        "usage",
        "response"
      ],
      "additionalProperties": false
    }
  }
}
