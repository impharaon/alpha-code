{
  "serverSha256": "63391a335a078d7f5873d52447bf3e49062b7184a0dcf2a5cdd788d58081009f",
  "formats": {
    "word": {
      "command": [
        "{codepuppyResources}/office-runtime/bin/python3",
        "-I",
        "-B",
        "{codepuppyResources}/office-mcp/server.py",
        "word",
        "{workspace}"
      ],
      "tools": [
        {
          "name": "read_docx",
          "description": "Read paragraphs and tables from a Word document",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute path inside the granted workspace"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "write_docx",
          "description": "Create, replace, or append to a Word document: title, body paragraphs, multi-level headings, tables, page size/margins (A4 default) and fonts (East Asian font set by default). Unknown fields are refused, never silently dropped.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute path inside the granted workspace"
              },
              "title": {
                "type": "string",
                "description": "Document title (Title style), written before the blocks"
              },
              "paragraphs": {
                "type": "array",
                "description": "Document body in order. A bare string is a body paragraph; use heading blocks for section titles (e.g. 一、总体情况) instead of body text.",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "paragraph"
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "heading"
                        },
                        "text": {
                          "type": "string"
                        },
                        "level": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9
                        }
                      },
                      "required": [
                        "type",
                        "text",
                        "level"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "table"
                        },
                        "rows": {
                          "type": "array",
                          "minItems": 1,
                          "description": "Rectangular grid of cell strings; row 0 is the header when header=true",
                          "items": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "header": {
                          "type": "boolean",
                          "default": true
                        }
                      },
                      "required": [
                        "type",
                        "rows"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "append": {
                "type": "boolean",
                "default": false
              },
              "page": {
                "type": "object",
                "description": "Page geometry. New documents default to A4 portrait with 25.4 mm margins; when appending, page is only changed if this field is given (then unspecified margins reset to 25.4 mm).",
                "properties": {
                  "size": {
                    "type": "string",
                    "enum": [
                      "A4",
                      "Letter"
                    ],
                    "default": "A4"
                  },
                  "orientation": {
                    "type": "string",
                    "enum": [
                      "portrait",
                      "landscape"
                    ],
                    "default": "portrait"
                  },
                  "margins": {
                    "type": "object",
                    "description": "Millimetres, 0–100",
                    "properties": {
                      "top": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "bottom": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "left": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "right": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "font": {
                "type": "object",
                "description": "Document-default fonts. New documents always get an East Asian font (宋体 unless eastAsia is given); when appending, fonts only change if this field is given.",
                "properties": {
                  "eastAsia": {
                    "type": "string",
                    "description": "CJK font family, e.g. 宋体 / 黑体 / 微软雅黑"
                  },
                  "latin": {
                    "type": "string",
                    "description": "Latin font family, e.g. Times New Roman"
                  },
                  "size": {
                    "type": "number",
                    "minimum": 6,
                    "maximum": 72,
                    "description": "Body text size in points"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "path",
              "paragraphs"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "excel": {
      "command": [
        "{codepuppyResources}/office-runtime/bin/python3",
        "-I",
        "-B",
        "{codepuppyResources}/office-mcp/server.py",
        "excel",
        "{workspace}"
      ],
      "tools": [
        {
          "name": "read_xlsx",
          "description": "Read calculated values, formulas and error locations with explicit cache sources and cursors",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute path inside the granted workspace"
              },
              "sheet": {
                "type": "string"
              },
              "range": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "values",
                  "formulas",
                  "both"
                ]
              },
              "rows": {
                "type": "integer",
                "minimum": 1
              },
              "cursor": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "excel_inspect",
          "description": "Inspect workbook structure, read ranges or find literal text with formula values and source-bound cursors",
          "inputSchema": {
            "type": "object",
            "$defs": {
              "FindInspect": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "title": "Path",
                    "type": "string"
                  },
                  "action": {
                    "const": "find",
                    "title": "Action",
                    "type": "string"
                  },
                  "query": {
                    "title": "Query",
                    "type": "string"
                  },
                  "sheet": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Sheet"
                  },
                  "exact": {
                    "default": false,
                    "title": "Exact",
                    "type": "boolean"
                  },
                  "caseSensitive": {
                    "default": false,
                    "title": "Casesensitive",
                    "type": "boolean"
                  },
                  "mode": {
                    "default": "values",
                    "enum": [
                      "values",
                      "formulas"
                    ],
                    "title": "Mode",
                    "type": "string"
                  },
                  "cursor": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Cursor"
                  }
                },
                "required": [
                  "path",
                  "action",
                  "query"
                ],
                "title": "FindInspect",
                "type": "object"
              },
              "RangeInspect": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "title": "Path",
                    "type": "string"
                  },
                  "action": {
                    "const": "range",
                    "title": "Action",
                    "type": "string"
                  },
                  "sheet": {
                    "title": "Sheet",
                    "type": "string"
                  },
                  "range": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Range"
                  },
                  "mode": {
                    "default": "values",
                    "enum": [
                      "values",
                      "formulas",
                      "both"
                    ],
                    "title": "Mode",
                    "type": "string"
                  },
                  "rows": {
                    "anyOf": [
                      {
                        "exclusiveMinimum": 0,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Rows"
                  },
                  "cursor": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Cursor"
                  }
                },
                "required": [
                  "path",
                  "action",
                  "sheet"
                ],
                "title": "RangeInspect",
                "type": "object"
              },
              "SheetInspect": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "title": "Path",
                    "type": "string"
                  },
                  "action": {
                    "const": "sheet",
                    "title": "Action",
                    "type": "string"
                  },
                  "sheet": {
                    "title": "Sheet",
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "action",
                  "sheet"
                ],
                "title": "SheetInspect",
                "type": "object"
              },
              "WorkbookInspect": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "title": "Path",
                    "type": "string"
                  },
                  "action": {
                    "const": "workbook",
                    "title": "Action",
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "action"
                ],
                "title": "WorkbookInspect",
                "type": "object"
              }
            },
            "discriminator": {
              "mapping": {
                "find": "#/$defs/FindInspect",
                "range": "#/$defs/RangeInspect",
                "sheet": "#/$defs/SheetInspect",
                "workbook": "#/$defs/WorkbookInspect"
              },
              "propertyName": "action"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/WorkbookInspect"
              },
              {
                "$ref": "#/$defs/SheetInspect"
              },
              {
                "$ref": "#/$defs/RangeInspect"
              },
              {
                "$ref": "#/$defs/FindInspect"
              }
            ]
          }
        },
        {
          "name": "excel_edit",
          "description": "Sort a range or replace literal text through the shared preserving save and pivot-refresh path",
          "inputSchema": {
            "type": "object",
            "$defs": {
              "ReplaceEdit": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "title": "Path",
                    "type": "string"
                  },
                  "action": {
                    "const": "replace",
                    "title": "Action",
                    "type": "string"
                  },
                  "query": {
                    "title": "Query",
                    "type": "string"
                  },
                  "replacement": {
                    "title": "Replacement",
                    "type": "string"
                  },
                  "sheet": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Sheet"
                  },
                  "exact": {
                    "default": false,
                    "title": "Exact",
                    "type": "boolean"
                  },
                  "caseSensitive": {
                    "default": false,
                    "title": "Casesensitive",
                    "type": "boolean"
                  },
                  "inFormulas": {
                    "default": false,
                    "title": "Informulas",
                    "type": "boolean"
                  }
                },
                "required": [
                  "path",
                  "action",
                  "query",
                  "replacement"
                ],
                "title": "ReplaceEdit",
                "type": "object"
              },
              "SortEdit": {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "title": "Path",
                    "type": "string"
                  },
                  "action": {
                    "const": "sort",
                    "title": "Action",
                    "type": "string"
                  },
                  "sheet": {
                    "title": "Sheet",
                    "type": "string"
                  },
                  "range": {
                    "title": "Range",
                    "type": "string"
                  },
                  "sortBy": {
                    "items": {
                      "$ref": "#/$defs/SortKey"
                    },
                    "minItems": 1,
                    "title": "Sortby",
                    "type": "array"
                  },
                  "hasHeader": {
                    "default": true,
                    "title": "Hasheader",
                    "type": "boolean"
                  }
                },
                "required": [
                  "path",
                  "action",
                  "sheet",
                  "range",
                  "sortBy"
                ],
                "title": "SortEdit",
                "type": "object"
              },
              "SortKey": {
                "additionalProperties": false,
                "properties": {
                  "column": {
                    "description": "Header text (if has_header) or column letter.",
                    "title": "Column",
                    "type": "string"
                  },
                  "order": {
                    "default": "ascending",
                    "enum": [
                      "ascending",
                      "descending"
                    ],
                    "title": "Order",
                    "type": "string"
                  }
                },
                "required": [
                  "column"
                ],
                "title": "SortKey",
                "type": "object"
              }
            },
            "discriminator": {
              "mapping": {
                "replace": "#/$defs/ReplaceEdit",
                "sort": "#/$defs/SortEdit"
              },
              "propertyName": "action"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SortEdit"
              },
              {
                "$ref": "#/$defs/ReplaceEdit"
              }
            ]
          }
        },
        {
          "name": "excel_objects",
          "description": "Describe or apply a typed pivot, slicer or sparkline operation",
          "inputSchema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "describe",
                  "apply"
                ]
              },
              "operation": {
                "type": "string",
                "enum": [
                  "create_pivot_table",
                  "delete_pivot_table",
                  "add_slicer",
                  "delete_slicer",
                  "add_sparklines",
                  "delete_sparklines"
                ]
              },
              "path": {
                "type": "string"
              },
              "inputJson": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "operation"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "excel_recalculate",
          "description": "Recalculate a copy with verified LibreOffice, merge caches into the original package and report formula errors",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "write_xlsx",
          "description": "Create a workbook or update addressed cells in an existing workbook",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute path inside the granted workspace"
              },
              "sheets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "cells": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "name",
                    "cells"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "path",
              "sheets"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "powerpoint": {
      "command": [
        "{codepuppyResources}/office-runtime/bin/python3",
        "-I",
        "-B",
        "{codepuppyResources}/office-mcp/server.py",
        "powerpoint",
        "{workspace}"
      ],
      "tools": [
        {
          "name": "read_pptx",
          "description": "Read text from every slide in a PowerPoint deck",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute path inside the granted workspace"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "write_pptx",
          "description": "Create, replace, or append text slides in a PowerPoint deck",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute path inside the granted workspace"
              },
              "slides": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "body": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "title",
                    "body"
                  ],
                  "additionalProperties": false
                }
              },
              "append": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "path",
              "slides"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "pdf": {
      "command": [
        "{codepuppyResources}/office-runtime/bin/python3",
        "-I",
        "-B",
        "{codepuppyResources}/office-mcp/server.py",
        "pdf",
        "{workspace}"
      ],
      "tools": [
        {
          "name": "read_pdf",
          "description": "Extract the text layer from every PDF page",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute path inside the granted workspace"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "write_pdf",
          "description": "Generate a text PDF, replace its text document, or append text pages",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Absolute path inside the granted workspace"
              },
              "pages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mode": {
                "type": "string",
                "enum": [
                  "replace",
                  "append"
                ],
                "default": "replace"
              }
            },
            "required": [
              "path",
              "pages"
            ],
            "additionalProperties": false
          }
        }
      ]
    }
  }
}
