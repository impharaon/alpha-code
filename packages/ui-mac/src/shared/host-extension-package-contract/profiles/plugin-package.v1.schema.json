                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "sourcePath",
                  "sourceName",
                  "kind",
                  "hook"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "sourcePath": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^/]+(?:/[^/]+)*$"
                  },
                  "sourceName": {
                    "type": "string"
                  },
                  "kind": {
                    "const": "hook"
                  },
                  "hook": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "event",
                      "command",
                      "timeoutSeconds",
                      "async",
                      "asyncRewake",
                      "onFailure",
                      "order",
                      "scope"
                    ],
                    "properties": {
                      "event": {
                        "enum": [
                          "SessionStart",
                          "UserPromptSubmit",
                          "UserPromptExpansion",
                          "PreToolUse",
                          "PostToolUse",
                          "PostToolUseFailure",
                          "Stop",
                          "StopFailure",
                          "PermissionRequest"
                        ]
                      },
                      "matcher": {
                        "type": "string"
                      },
                      "if": {
                        "type": "string"
                      },
                      "command": {
                        "$ref": "#/$defs/Text"
                      },
                      "timeoutSeconds": {
                        "type": "number",
                        "minimum": 0
                      },
                      "async": {
                        "type": "boolean"
                      },
                      "asyncRewake": {
                        "type": "boolean"
                      },
                      "onFailure": {
                        "enum": [
                          "continue",
                          "block"
                        ]
                      },
                      "order": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "scope": {
                        "oneOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind"
                            ],
                            "properties": {
                              "kind": {
                                "const": "package"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "entryId"
                            ],
                            "properties": {
                              "kind": {
                                "enum": [
                                  "skill",
                                  "agent"
                                ]
                              },
                              "entryId": {
                                "type": "string"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "componentId",
              "label",
              "targets"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "componentId": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "file",
                    "pointer"
                  ],
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^/]+(?:/[^/]+)*$"
                    },
                    "pointer": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "code",
              "message"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "code": {
                "enum": [
                  "invalid-definition",
                  "missing-entry",
                  "unresolved-app-id",
                  "native-js-plugin"
                ]
              },
              "sourceName": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "title",
              "description",
              "required",
              "sensitive"
            ],
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "sensitive": {
                "type": "boolean"
              },
              "default": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "object"
                ]
              }
            }
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agent": {
              "type": "string"
            }
          }
        }
      }
    },
    "blobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "bytes",
          "mediaType",
          "url"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "mediaType": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    }
  },
  "$defs": {
    "Text": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding"
            ],
            "properties": {
              "binding": {
                "enum": [
                  "pluginRoot",
                  "skillDir",
                  "projectDir",
                  "pluginData"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "secret"
            ],
            "properties": {
              "secret": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option"
            ],
            "properties": {
              "option": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "environment"
            ],
            "properties": {
              "environment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "default": {
                    "$ref": "#/$defs/Text"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
