{
  "id": "mcp:playwright",
  "type": "mcp",
  "name": "playwright",
  "displayName": "浏览器操作（Playwright）",
  "description": "让助手打开网页、点击、填写表单、截图和运行页面脚本，也能读取需要 JavaScript 加载的网页。由 Microsoft 提供。使用前请在本机安装 Google Chrome 和 Node.js 18 或以上版本。",
  "source": "official",
  "category": "dev",
  "license": "Apache-2.0",
  "redistributable": true,
  "version": "1.0.0",
  "installSpec": {
    "kind": "mcp",
    "mcpType": "local",
    "command": [
      "npx",
      "-y",
      "@playwright/mcp@0.0.77"
    ],
    "requiredEnvVars": [],
    "runtimeDep": [
      "node"
    ]
  },
  "tools": [
    {
      "name": "browser_navigate",
      "description": "打开指定网页"
    },
    {
      "name": "browser_click",
      "description": "点击网页中的按钮或其它元素"
    },
    {
      "name": "browser_type",
      "description": "输入文字或填写网页表单"
    },
    {
      "name": "browser_snapshot",
      "description": "读取页面的文字和控件信息，帮助助手理解网页"
    },
    {
      "name": "browser_take_screenshot",
      "description": "截取网页画面"
    },
    {
      "name": "browser_evaluate",
      "description": "在网页中运行 JavaScript 代码"
    }
  ],
